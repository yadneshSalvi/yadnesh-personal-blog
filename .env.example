# Environment variables for yadneshsalvi.com.
#
# Copy to .env.local for development; set the same keys in the Vercel project
# for preview and production. Real .env files are gitignored and never leave the
# machine. Generate every secret below with: openssl rand -hex 32

# ── Contact form (already live) ─────────────────────────────────────────────
# Zoho SMTP credentials used only by /api/contact. Separate from the newsletter
# sender below; do not merge the two.
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# ── The Agentic Brief: sending (Phase 3) ────────────────────────────────────
# Sender identity is The Agentic Brief <newsletter@yadneshsalvi.com>.
NEWSLETTER_ZOHO_SMTP_HOST=smtp.zoho.in
NEWSLETTER_ZOHO_SMTP_PORT=465
NEWSLETTER_ZOHO_SMTP_USER=
NEWSLETTER_ZOHO_SMTP_PASS=

# Signs every confirm, unsubscribe, preferences, approve/hold, and feedback
# link. HMAC-SHA256 over purpose:subject:cadence:expiry, so no DB lookup is
# needed to verify a token. Rotating this invalidates every outstanding link.
BRIEF_TOKEN_SECRET=

# Shared with the feed repo. Authenticates the pipeline's call to
# POST /api/brief/notify after an issue PR merges.
BRIEF_PIPELINE_SECRET=

# Vercel sends this on cron invocations; the send poller refuses anything else.
CRON_SECRET=

# Physical mailing address printed in every marketing email. CAN-SPAM requires
# it and the send path hard-refuses to send while this is unset. A registered PO
# box or CMRA mailbox qualifies; a purely virtual address does not.
BRIEF_POSTAL_ADDRESS=

# Where approval notifications go.
BRIEF_APPROVER_EMAIL=

# ── The Agentic Brief: subscribe form (Phase 2) ─────────────────────────────
# Cloudflare Turnstile, validated server-side behind a honeypot and a timing
# check, with double opt-in as the final filter.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Newsletter mail driver ──────────────────────────────────────────────────
# When RESEND_API_KEY is set the mailer sends through Resend's API (the domain
# yadneshsalvi.com is verified there); otherwise it falls back to Zoho SMTP.
# BRIEF_MAIL_DRIVER=resend|zoho-smtp forces one. BRIEF_FROM_EMAIL overrides the
# sending address; without it the Zoho SMTP user is used, so set it on
# deployments that carry only the Resend key.
RESEND_API_KEY=
# BRIEF_MAIL_DRIVER=
BRIEF_FROM_EMAIL=newsletter@yadneshsalvi.com

# ── The Agentic Brief: subscriber store ─────────────────────────────────────
# Upstash Redis, provisioned through the Vercel Marketplace, which injects
# these two keys into the project automatically. Set them by hand only for
# local development against the same database (copy them from the Upstash
# console or run `vercel env pull`). Older Vercel KV wiring names the same
# pair KV_REST_API_URL and KV_REST_API_TOKEN; the code reads either and
# prefers UPSTASH_*. While both are unset, every subscribe route answers 503
# and the site stays buildable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Set by Vercel, listed for reference ─────────────────────────────────────
# VERCEL_ENV distinguishes production from preview. Draft issues render only
# when it is not "production"; nothing needs to set it locally.
